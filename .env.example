# Copy to .env and fill in. .env is gitignored.
MUNNEL_DOMAIN=tunnels.example.com
MUNNEL_TOKENS=replace-with-openssl-rand-hex-24
MUNNEL_SCHEME=https

# Optional: HMAC key for signed, scoped tokens (munnel-server mint). Generate
# with: openssl rand -hex 32
#MUNNEL_SIGNING_KEY=

# Optional: dev/test forward-auth. --auth-stub trusts any submitted user —
# only enable for dev/test, never production. A real OIDC provider is the
# production path (see internal/forwardauth.Provider).
#MUNNEL_AUTH_STUB=false

# Optional: HMAC key for forward-auth session cookies. Generate with:
# openssl rand -hex 32. If unset with --auth-stub, an ephemeral key is used
# (sessions do not survive a restart).
#MUNNEL_SESSION_KEY=