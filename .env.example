# Copy to .env and fill in. .env is gitignored.
MUNNEL_DOMAIN=tunnels.example.com
MUNNEL_TOKENS=replace-with-openssl-rand-hex-24
MUNNEL_SCHEME=https

# Optional: HMAC key for signed, scoped tokens (munnel-server mint). Generate
# with: openssl rand -hex 32
#MUNNEL_SIGNING_KEY=

# Optional: dev/test forward-auth. --auth-stub trusts any submitted user —
# only enable for dev/test, never production. A real OIDC provider is the
# production path (see internal/forwardauth.Provider).
#MUNNEL_AUTH_STUB=false

# Optional: HMAC key for forward-auth session cookies. Generate with:
# openssl rand -hex 32. If unset with --auth-stub, an ephemeral key is used
# (sessions do not survive a restart).
#MUNNEL_SESSION_KEY=

# Optional: password for self-service token issuance. Requires MUNNEL_SIGNING_KEY.
# Team members run `munnel token --sub <name>`, enter this password, and get a
# signed token written to ~/.munnel/config — no operator involvement. Share it
# with your team (1Password, Slack); rotate it if it leaks.
#MUNNEL_ENROLL_PASSWORD=

# Optional: further base domains, comma-separated. A tunnel "myapp" is then
# also served at myapp.<each domain>, next to myapp.$MUNNEL_DOMAIN (one shared
# set of names). The apex and www. of these domains are left alone (mail, a
# website). Each name needs its own DNS record, e.g. myapp.example.org A <ip>;
# certificates come on demand, only for names with a live tunnel. Apply with
# `docker compose up -d` (a restart does not re-read .env).
#MUNNEL_EXTRA_DOMAINS=