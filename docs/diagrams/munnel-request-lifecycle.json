  "cards": [
    {
      "dot": "emerald",
      "title": "Concurrent by Framing",
      "items": [
        "Every exchange is a stream on the one TCP :7001 socket",
        "9-byte header: type \u00b7 stream id \u00b7 payload length, chunked to 1 MiB frames",
        "Stream ids use parity: server odd, client even \u2014 both sides may open"
      ]
    },
    {
      "dot": "cyan",
      "title": "Half-Close Semantics",
      "items": [
        "CLOSE is directional: the peer sees EOF but may still write",
        "Both sides CLOSE, then the stream id retires",
        "RESET aborts immediately on error"
      ]
    },
    {
      "dot": "violet",
      "title": "Capture Without Replays",
      "items": [
        "The forwarder tees each exchange into the inspector's 200-entry ring",
        "Watch webhooks land live \u2014 or replay them to localhost yourself"
      ]
    }
  ]
}